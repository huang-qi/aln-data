# 谐振器数据平台 - 环境变量模板
# 复制为 .env 并填入实际值
# .env 不进 git

# ===== 数据库 =====
POSTGRES_DB=aln
POSTGRES_USER=aln
POSTGRES_PASSWORD=changeme_in_prod

# ===== 应用 =====
# 数据根目录（pgdata / redis / uploads / files / exports / logs 全部落在这）
# 部署到新机器时，请改成本机数据盘上的实际路径
DATA_ROOT=/data3/aln
UPLOAD_MAX_GB=20
LOG_LEVEL=INFO

# ===== 任务队列 =====
WORKER_CONCURRENCY=4

# ===== 反向代理 =====
NGINX_PORT=8080
